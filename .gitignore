# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
build/

# Local DuckLake data (parquet). In production this lives in S3; for the
# local prototype the DATA_PATH lands here and is NOT checked in.
/data/

# The DuckLake *catalog* IS checked in (see catalog/). Ignore its sidecar
# WAL/tmp files only.
catalog/*.wal
catalog/*.tmp

# Only encrypted secrets (*.enc.env) may be committed. Never a plaintext .env.
*.env
!*.enc.env
